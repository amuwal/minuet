OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Required to gate 議事録 generation (any /api/process, /api/transcribe, /api/generate
# call). Viewing the app and history is unaffected.
CREATE_PASSWORD=change_me_in_local_env

# Optional: override Whisper/Claude models
# WHISPER_MODEL=whisper-1
# CLAUDE_MODEL=claude-sonnet-4-6
